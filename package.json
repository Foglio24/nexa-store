{
  "name": "nexa-store",
  "private": true,
  "version": "0.5.0",
  "description": "An app store for Ubuntu: APT, Flatpak and Snap in one place",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Foglio24/nexa-store.git"
  },
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
